# NODE.JS
# ========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager lock files (optional - some keep these)
# package-lock.json
# yarn.lock

# ========================================
# LOGS
# ========================================

# Log files
logs/
*.log

